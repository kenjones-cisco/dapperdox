FROM node:24-bookworm-slim AS node
FROM golang:1.26.11

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
COPY package.json package-lock.json /opt/browser-tests/
RUN cd /opt/browser-tests && npm ci \
    && npx playwright install --with-deps chromium
ENV NODE_PATH=/opt/browser-tests/node_modules
ENV PATH="/opt/browser-tests/node_modules/.bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        gettext-base \
        zip \
    && rm -rf /var/lib/apt/lists/*

ENV YQ_BIN_VERSION=v4.50.1

ENV GOPATH=/go
ENV GOBIN=/go/bin
ENV GOLANGCI_LINT_VERSION=v2.12.2

RUN wget -O /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/${YQ_BIN_VERSION}/yq_linux_$(go env GOARCH)" \
    && chmod 755 /usr/local/bin/yq

RUN go install golang.org/x/tools/cmd/goimports@v0.52.0 \
    && go install github.com/mitchellh/gox@v1.0.1 \
    && go install gotest.tools/gotestsum@v1.13.0 \
    && wget -O /tmp/golangci-lint-install.sh https://raw.githubusercontent.com/golangci/golangci-lint/v2.12.2/install.sh \
    && sh /tmp/golangci-lint-install.sh -b ${GOBIN} ${GOLANGCI_LINT_VERSION} \
    && rm /tmp/golangci-lint-install.sh \
    && rm -rf /go/src/*

ENV CGO_ENABLED=0 \
    GOFLAGS='-buildvcs=false'

COPY scripts/golangci-base.yml /usr/local/etc/golangci.yml
