<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" href="/favicon.ico">
    <script src="/browser/browser.js"></script>
    <script src="/js/explorer.js"></script>
    <link href="/browser/bootstrap.css" rel="stylesheet">
    <link href="/browser/highlight.css" rel="stylesheet">
    [: template "fragments/styles" . :]
    [: template "fragments/fonts" . :]
    <title>[: .Info.Title :]: [: .Title :]</title>
  </head>
  <body [: if .Config.ShowAssets :][: if not .Guide :]class="debug_body"[: end :][: end :]>
    <nav class="navbar navbar-expand-md fixed-top shadow" data-bs-theme="dark">
      <div class="container-fluid">
        [: template "fragments/header_bar" . :]
      </div>
    </nav>
    <div class="container-fluid">
      <div class="row">
        <div class="col-12 col-xl-10 offset-xl-1 main-body">
          [: template "fragments/body" . :]
        </div>
      </div>
    </div>
    <div class="container-fluid">
      [: template "fragments/author_debug" . :]
      <div id="footer" class="footer">
        <div class="row">
          <div class="col-12 col-xl-10 offset-xl-1">
            [: template "fragments/footer" . :]
          </div>
        </div>
      </div>
    </div>
    [: template "fragments/scripts" . :]
  </body>
</html>
